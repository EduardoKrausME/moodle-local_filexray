<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/filexray/db" VERSION="20261014" COMMENT="File X-Ray database schema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_filexray_report" COMMENT="Inventory report snapshots">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="queued"/>
        <FIELD NAME="totalcourses" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timefinished" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="useridx" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="statusidx" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_filexray_course" COMMENT="One persisted inventory job per course and report">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="reportid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="coursename" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="filecount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timefinished" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="errormessage" TYPE="text" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="reportfk" TYPE="foreign" FIELDS="reportid" REFTABLE="local_filexray_report" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="reportcourseuix" UNIQUE="true" FIELDS="reportid, courseid"/>
        <INDEX NAME="reportstatusidx" UNIQUE="false" FIELDS="reportid, status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_filexray_file" COMMENT="Selected Moodle file IDs associated with a course snapshot">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="reportid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="reportcourseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="fileid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="contenthash" TYPE="char" LENGTH="40" NOTNULL="true"/>
        <FIELD NAME="filesize" TYPE="int" LENGTH="20" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="component" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="filearea" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="filename" TYPE="char" LENGTH="255" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="coursefk" TYPE="foreign" FIELDS="reportcourseid" REFTABLE="local_filexray_course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="coursefileuix" UNIQUE="true" FIELDS="reportcourseid, fileid"/>
        <INDEX NAME="reportfileidx" UNIQUE="false" FIELDS="reportid, fileid"/>
        <INDEX NAME="reporthashidx" UNIQUE="false" FIELDS="reportid, contenthash"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>