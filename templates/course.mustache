{{!
    @template local_filexray/course
}}
<div class="local-filexray-course">
    <h3>{{coursename}}</h3>
    <p>{{#str}}matchedfiles, local_filexray{{/str}} {{filecount}}</p>
    {{#selectedcomponent}}
        <p class="filexray-component-filter">
            {{#str}}coursecomponentfilter, local_filexray{{/str}}
            <strong>{{selectedcomponentname}}</strong> (<code>{{selectedcomponent}}</code>)
            <a href="{{{allcomponentsurl}}}" class="btn btn-sm btn-outline-secondary ml-2">
                {{#str}}courseallcomponents, local_filexray{{/str}}
            </a>
        </p>
    {{/selectedcomponent}}
    <div class="row filexray-component-charts mb-4">
        <div class="col-12 col-lg-6 mb-3">
            <section class="card filexray-chart h-100" aria-labelledby="filexray-component-files">
                <div class="card-body">
                    <h4 class="h5" id="filexray-component-files">{{#str}}coursechartfiles, local_filexray{{/str}}</h4>
                    <p class="text-muted small">{{#str}}coursechartnote, local_filexray{{/str}}</p>
                    {{#hascomponents}}
                        <ol class="filexray-component-list">
                            {{#components}}
                                <li>
                                    <a href="{{{url}}}" class="filexray-component-link{{#selected}} filexray-component-link--active{{/selected}}" {{#selected}}aria-current="true"{{/selected}}>
                                        <span class="filexray-component-heading">
                                            <span>{{componentname}} <code>{{component}}</code></span>
                                            <strong>{{formattedfilecount}}</strong>
                                        </span>
                                        <span class="filexray-chart-bar-track" aria-hidden="true">
                                            <span class="filexray-chart-bar" style="width: {{fileswidth}}%;"></span>
                                        </span>
                                    </a>
                                </li>
                            {{/components}}
                        </ol>
                    {{/hascomponents}}
                    {{^hascomponents}}<p>{{#str}}chartnodata, local_filexray{{/str}}</p>{{/hascomponents}}
                </div>
            </section>
        </div>
        <div class="col-12 col-lg-6 mb-3">
            <section class="card filexray-chart h-100" aria-labelledby="filexray-component-bytes">
                <div class="card-body">
                    <h4 class="h5" id="filexray-component-bytes">{{#str}}coursechartbytes, local_filexray{{/str}}</h4>
                    <p class="text-muted small">{{#str}}coursechartnote, local_filexray{{/str}}</p>
                    {{#hascomponents}}
                        <ol class="filexray-component-list">
                            {{#components}}
                                <li>
                                    <a href="{{{url}}}" class="filexray-component-link{{#selected}} filexray-component-link--active{{/selected}}" {{#selected}}aria-current="true"{{/selected}}>
                                        <span class="filexray-component-heading">
                                            <span>{{componentname}} <code>{{component}}</code></span>
                                            <strong>{{size}}</strong>
                                        </span>
                                        <span class="filexray-chart-bar-track" aria-hidden="true">
                                            <span class="filexray-chart-bar" style="width: {{byteswidth}}%;"></span>
                                        </span>
                                    </a>
                                </li>
                            {{/components}}
                        </ol>
                    {{/hascomponents}}
                    {{^hascomponents}}<p>{{#str}}chartnodata, local_filexray{{/str}}</p>{{/hascomponents}}
                </div>
            </section>
        </div>
    </div>
    {{#hasfiles}}
    <table class="generaltable table">
        <thead><tr>
            <th scope="col">{{#str}}filename, local_filexray{{/str}}</th>
            <th scope="col">{{#str}}component, local_filexray{{/str}} / {{#str}}filearea, local_filexray{{/str}}</th>
            <th scope="col">{{#str}}filesize, local_filexray{{/str}}</th>
        </tr></thead>
        <tbody>{{#files}}<tr>
            <td>
                {{filename}}
                {{#canpreview}}
                    <a href="{{{previewurl}}}" target="_blank" rel="noopener noreferrer"
                        title="{{#str}}preview, local_filexray{{/str}}"
                        aria-label="{{#str}}preview, local_filexray{{/str}} {{filename}}">↗</a>
                {{/canpreview}}
                {{#candownload}}
                    <a href="{{{previewurl}}}" title="{{#str}}downloadfile, local_filexray{{/str}}"
                        aria-label="{{#str}}downloadfile, local_filexray{{/str}} {{filename}}">↗</a>
                {{/candownload}}
            </td>
            <td>
                <code title="{{component}}">{{componentname}} / {{filearea}}</code>
                {{#docurl}}
                    <br>
                    <a href="{{{docurl}}}" target="_blank" rel="noopener noreferrer">
                        {{#str}}areadoclink, local_filexray{{/str}} ↗
                    </a>
                {{/docurl}}
            </td>
            <td>{{size}}</td>
        </tr>{{/files}}</tbody>
    </table>
    {{/hasfiles}}
    {{^hasfiles}}<p>{{#str}}chartnodata, local_filexray{{/str}}</p>{{/hasfiles}}
    <div class="d-flex gap-2">
        {{#previous}}<a href="{{{previousurl}}}" class="btn btn-secondary">{{#str}}previous, local_filexray{{/str}}</a>{{/previous}}
        {{#next}}<a href="{{{nexturl}}}" class="btn btn-secondary">{{#str}}next, local_filexray{{/str}}</a>{{/next}}
        <a href="{{{reporturl}}}" class="btn btn-link">{{#str}}reports, local_filexray{{/str}}</a>
    </div>
</div>
