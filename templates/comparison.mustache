<div class="local-filexray-comparison">
    {{#provisional}}
        <div class="alert alert-warning" role="alert">
            {{#str}}reportnotready, local_filexray{{/str}}
        </div>
    {{/provisional}}
    <p>{{#str}}comparison_note, local_filexray{{/str}}</p>
    <div class="row filexray-stats mt-4 mb-3">
        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="card filexray-metric filexray-metric--total h-100">
                <div class="card-body">
                    <div class="filexray-metric-label">{{#str}}totaldatabase, local_filexray{{/str}}</div>
                    <div class="filexray-metric-value">{{total}}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="card filexray-metric filexray-metric--matched h-100">
                <div class="card-body">
                    <div class="filexray-metric-label">{{#str}}matched, local_filexray{{/str}}</div>
                    <div class="filexray-metric-value">{{matched}}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="card filexray-metric filexray-metric--outside h-100">
                <div class="card-body">
                    <div class="filexray-metric-label">{{#str}}unmatchedcount, local_filexray{{/str}}</div>
                    <div class="filexray-metric-value">{{unmatched}}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="card filexray-metric filexray-metric--courses h-100">
                <div class="card-body">
                    <div class="filexray-metric-label">{{#str}}coursecount, local_filexray{{/str}}</div>
                    <div class="filexray-metric-value">{{coursecount}}</div>
                </div>
            </div>
        </div>
    </div>
    <p class="mb-4">
        <a class="btn btn-outline-primary" href="{{{unmatchedurl}}}">
            {{#str}}unmatchedview, local_filexray{{/str}} →
        </a>
    </p>
    <h3>{{#str}}coursesummary, local_filexray{{/str}}</h3>
    <p>{{#str}}coursesummary_note, local_filexray{{/str}}</p>
    <table class="generaltable table">
        <thead>
            <tr>
                <th scope="col">{{#str}}course, local_filexray{{/str}}</th>
                <th scope="col">{{#str}}status, local_filexray{{/str}}</th>
                <th scope="col">{{#str}}files, local_filexray{{/str}}</th>
                <th scope="col">{{#str}}bytes, local_filexray{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#courses}}
                <tr>
                    <td><a href="{{{url}}}">{{{coursename}}} (#{{courseid}})</a></td>
                    <td>{{status}}</td>
                    <td>{{filecount}}</td>
                    <td>{{bytecount}} ({{size}})</td>
                </tr>
            {{/courses}}
        </tbody>
    </table>
    <div class="d-flex gap-2">
        {{#previouscourse}}<a href="{{{previouscourseurl}}}" class="btn btn-secondary">{{#str}}previous, local_filexray{{/str}}</a>{{/previouscourse}}
        {{#nextcourse}}<a href="{{{nextcourseurl}}}" class="btn btn-secondary">{{#str}}next, local_filexray{{/str}}</a>{{/nextcourse}}
    </div>
    <h3 class="mt-4">{{#str}}areasummary, local_filexray{{/str}}</h3>
    <p>{{#str}}areasummary_note, local_filexray{{/str}}</p>
    <table class="generaltable table">
        <thead>
            <tr>
                <th scope="col">{{#str}}areaname, local_filexray{{/str}} / {{#str}}areadescription, local_filexray{{/str}}</th>
                <th scope="col">{{#str}}component, local_filexray{{/str}} / {{#str}}filearea, local_filexray{{/str}}</th>
                <th scope="col">{{#str}}areatotalfiles, local_filexray{{/str}}</th>
                <th scope="col">{{#str}}areatotalbytes, local_filexray{{/str}}</th>
                <th scope="col">{{#str}}areaoutsidefiles, local_filexray{{/str}}</th>
                <th scope="col">{{#str}}areaoutsidebytes, local_filexray{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#areas}}
                <tr>
                    <td>
                        <h4 class="h6 mb-2">{{name}}</h4>
                        <p class="mb-1">{{description}}</p>
                        <a href="{{{docurl}}}" target="_blank" rel="noopener noreferrer">
                            <strong>{{#str}}areadoclink, local_filexray{{/str}}</strong> ↗
                        </a>
                    </td>
                    <td><code>{{component}}/{{filearea}}</code></td>
                    <td>{{allcount}}</td>
                    <td>{{allsize}}</td>
                    <td>{{outsidecount}}</td>
                    <td>{{outsidesize}}</td>
                </tr>
            {{/areas}}
        </tbody>
    </table>
</div>
