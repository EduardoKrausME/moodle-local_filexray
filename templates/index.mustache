{{!
    @template local_filexray/index
}}
<div class="local-filexray-index" data-region="filexray-index" data-report-url="{{{reportbaseurl}}}"
    data-delete-title="{{#str}}deletereport, local_filexray{{/str}}"
    data-delete-body="{{#str}}deletereportconfirm, local_filexray{{/str}}"
    data-delete-label="{{#str}}deletereport, local_filexray{{/str}}"
    data-report-busy="{{#str}}reportbusy, local_filexray{{/str}}"
    data-reports-busy="{{#str}}reportsbusy, local_filexray{{/str}}">
    <div class="alert alert-warning" role="alert" tabindex="-1" data-region="operation-warning" hidden></div>
    <p>{{#str}}notbackup, local_filexray{{/str}}</p>
    <p>{{#str}}croninfo, local_filexray{{/str}}</p>
    <p><strong>{{#str}}coursecount, local_filexray{{/str}}</strong> {{courses}}</p>
    {{#canrun}}
        <button id="filexray-generate" class="btn btn-primary" type="button" disabled>
            {{#str}}generate, local_filexray{{/str}}
        </button>
    {{/canrun}}
    
    {{#hasreports}}
        <h3 class="mt-4">{{#str}}previousreports, local_filexray{{/str}}</h3>
        <table class="generaltable table">
            <thead>
                <tr>
                    <th scope="col">{{#str}}id, local_filexray{{/str}}</th>
                    <th scope="col">{{#str}}status, local_filexray{{/str}}</th>
                    <th scope="col">{{#str}}courses, local_filexray{{/str}}</th>
                    <th scope="col">{{#str}}created, local_filexray{{/str}}</th>
                    <th scope="col">{{#str}}view, local_filexray{{/str}}</th>
                    {{#canrun}}<th scope="col">{{#str}}deletereport, local_filexray{{/str}}</th>{{/canrun}}
                </tr>
            </thead>
            <tbody>
                {{#reports}}
                    <tr>
                        <td>{{id}}</td>
                        <td>{{status}}</td>
                        <td>{{totalcourses}}</td>
                        <td>{{created}}</td>
                        <td><a href="{{{url}}}">{{#str}}view, local_filexray{{/str}}</a></td>
                        {{#candelete}}
                            <td>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                    data-action="delete-report" data-reportid="{{id}}">
                                    {{#str}}deletereport, local_filexray{{/str}}
                                </button>
                            </td>
                        {{/candelete}}
                    </tr>
                {{/reports}}
            </tbody>
        </table>
    {{/hasreports}}
    {{^hasreports}}
        <p>{{#str}}no_reports, local_filexray{{/str}}</p>
    {{/hasreports}}
</div>